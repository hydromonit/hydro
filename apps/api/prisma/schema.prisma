generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DailyLog {
  id        Int      @id @default(autoincrement())
  batchId   Int      
  logDate   DateTime @default(now()) 
  phLevel   Float    
  ppmLevel  Int      
  waterTemp Float    
  notes     String?
  imageUrl  String?  
}